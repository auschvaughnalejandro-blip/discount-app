{"nodes": [{"id": "apps_web_member_public_images_place_images_here_hero_dropin", "label": "Hero Image Drop-In Convention", "file_type": "document", "source_file": "apps/web-member/public/images/PLACE-IMAGES-HERE.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The name after 'benefit-' is the offer's key shown in the admin dashboard next to the version number, so a new offer created there picks up a hero by someone saving benefit-<key>.jpg \u2014 only a non-.jpg extension needs a line in src/screens/heroes.ts. Missing files fall back to a dashed IMAGE placeholder, so a partial set is fine and a typo never shows a broken image. AVIF is unsupported before iOS 16.4. benefit-lifestyle.jpg is still outstanding."}], "edges": [{"source": "apps_web_member_public_images_place_images_here_hero_dropin", "target": "apps_web_member_src_screens_heroes_hero", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/web-member/public/images/PLACE-IMAGES-HERE.txt", "source_location": "16", "weight": 1.0}, {"source": "apps_web_member_public_images_place_images_here_hero_dropin", "target": "apps_web_member_index_member_shell", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/web-member/public/images/PLACE-IMAGES-HERE.txt", "source_location": null, "weight": 1.0}, {"source": "apps_web_member_public_images_place_images_here_hero_dropin", "target": "system_overview_benefit_schedule", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "apps/web-member/public/images/PLACE-IMAGES-HERE.txt", "source_location": "3-11", "weight": 1.0}, {"source": "apps_web_member_public_images_place_images_here_hero_dropin", "target": "system_overview_benefit_versioning", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/web-member/public/images/PLACE-