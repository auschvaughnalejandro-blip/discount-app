{
  "name": "@pgp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "tsx --env-file=.env prisma/seed.ts",
    "mfa:code": "tsx --env-file=.env scripts/mfa-code.ts",
    "mail:test": "tsx --env-file=.env scripts/mail-test.ts",
    "sheets:sync": "tsx --env-file=.env scripts/sheets-sync.ts",
    "generate": "prisma generate",
    "predev": "powershell -ExecutionPolicy Bypass -File ../../scripts/stop.ps1 -Ports 3000"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@node-rs/argon2": "^2.0.2",
    "@pgp/shared": "*",
    "@prisma/client": "^6.19.0",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "googleapis": "^174.0.1",
    "jose": "^6.2.4",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.9",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
