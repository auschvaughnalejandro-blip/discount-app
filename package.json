{
  "name": "privilege-guest-program",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names api,member,admin --prefix-colors cyan,green,magenta \"npm:dev:api\" \"npm:dev:member\" \"npm:dev:admin\"",
    "dev:lan": "powershell -ExecutionPolicy Bypass -Command \"$env:DEV_HOST='0.0.0.0'; npm run dev\"",
    "dev:api": "npm run dev --workspace @pgp/api",
    "dev:member": "npm run dev --workspace @pgp/web-member",
    "dev:admin": "npm run dev --workspace @pgp/web-admin",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-db.ps1",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "migrate": "npm run migrate --workspace @pgp/api",
    "seed": "npm run seed --workspace @pgp/api",
    "mfa:code": "npm run mfa:code --workspace @pgp/api",
    "otp:code": "npm run otp:code --workspace @pgp/api",
    "sheets:sync": "npm run sheets:sync --workspace @pgp/api",
    "stop": "powershell -ExecutionPolicy Bypass -File ./scripts/stop.ps1",
    "predev": "powershell -ExecutionPolicy Bypass -File ./scripts/stop.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "typescript": "^5.9.3"
  }
}
