# Privilege Guest Program — environment variables
#
# Copy to .env and fill in. Never commit .env.
#
# Values marked TODO(spec) are named here because a later stage needs them, but
# their correct value comes from a reference document that is currently empty.
# See PROGRESS.md → "Open questions blocking work".

# ─── Runtime (Stage 0) ────────────────────────────────────────────────────────
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info

# ─── Database (Stages 0–1) ────────────────────────────────────────────────────
# Port 5433, not 5432: the compose stack publishes there so it does not collide
# with a PostgreSQL already installed on the host.
#
# The role the application connects as. The redemption_immutability migration
# revokes UPDATE/DELETE on "Redemption", "AuditLog" and "ConsentRecord" and
# DELETE on "Member" from this role (R7, R16), so it must NOT own the schema
# and must NOT be a superuser — an owner cannot be denied its own tables.
DATABASE_URL=postgresql://pgp_app:pgp_local_app@localhost:5433/pgp?schema=public

# The owning role, used for `prisma migrate` and for the seed. Separate from the
# application role so the revocation above is meaningful.
DATABASE_MIGRATION_URL=postgresql://pgp_owner:pgp_local_dev@localhost:5433/pgp?schema=public

# ─── Credentials (Stage 2) ────────────────────────────────────────────────────
# security-implementation.md §3: a pepper held in the key management service,
# not the database. No KMS exists in this build; this env var is the nearest
# equivalent available — see DECISIONS.md. Never reuse across environments.
PASSWORD_PEPPER=CHANGE_ME_32_BYTES_MINIMUM
OTP_CODE_HMAC_SECRET=CHANGE_ME_32_BYTES_MINIMUM
OTP_TTL_SECONDS=300                  # 5 minutes — security-implementation.md §3
OTP_MAX_ATTEMPTS=5                   # security-implementation.md §3

# ─── Tokens (Stage 2) ─────────────────────────────────────────────────────────
# The signing algorithm (HS256) is pinned in code and never read from a token
# header — see src/security/tokens.ts and DECISIONS.md for why HS256 rather
# than the EdDSA/RS256 §4 prefers.
JWT_ISSUER=privilege-guest-program
JWT_AUDIENCE_MEMBER=pgp-member
JWT_AUDIENCE_STAFF=pgp-staff
JWT_SIGNING_KEY=CHANGE_ME_32_BYTES_MINIMUM

# security-implementation.md §4 lifetimes, by surface:
#   access  — 10 min dashboard (administrator/manager/support),
#             15 min verification page (outlet_staff), 30 min member app
#   refresh — 12h staff (sliding), 30 days member (sliding)
ACCESS_TOKEN_TTL_MEMBER_SECONDS=1800
ACCESS_TOKEN_TTL_STAFF_DASHBOARD_SECONDS=600
ACCESS_TOKEN_TTL_STAFF_VERIFY_SECONDS=900
REFRESH_TOKEN_TTL_MEMBER_SECONDS=2592000
REFRESH_TOKEN_TTL_STAFF_SECONDS=43200

# ─── Rate limiting (Stage 2) ──────────────────────────────────────────────────
# security-implementation.md §3/§4/§8 require rate limiting "per IP and per
# identifier" but give no exact thresholds. These are a documented assumption
# (BUILD-PLAN §0 rule 4) — see DECISIONS.md and PROGRESS.md open questions.
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_PER_IP_MAX=20
RATE_LIMIT_LOGIN_PER_IDENTIFIER_MAX=5
RATE_LIMIT_OTP_WINDOW_SECONDS=900
RATE_LIMIT_OTP_REQUEST_PER_IP_MAX=10
RATE_LIMIT_OTP_REQUEST_PER_IDENTIFIER_MAX=3
RATE_LIMIT_OTP_VERIFY_PER_IP_MAX=20

# ─── Member lifecycle (Stage 4) ───────────────────────────────────────────────
# security-implementation.md §3 requires claim codes to expire "after a defined
# period" but does not define one, and product-definition.md §8 is silent.
# 720h = 30 days, assuming a posted invitation letter. A documented assumption —
# see PROGRESS.md.
CLAIM_CODE_TTL_HOURS=720

# §10: consent is stored with the wording version it was given against, so
# changing the wording later does not retroactively reinterpret past consent.
# Bump this whenever the consent wording shown to members changes.
CONSENT_WORDING_VERSION=v1-2026-07

# §3: "Strict rate limiting on the activation endpoint, since a guessable claim
# code grants a genuine membership."
RATE_LIMIT_CLAIM_WINDOW_SECONDS=900
RATE_LIMIT_CLAIM_PER_IP_MAX=10

# §8: "Pagination caps so no endpoint can be coerced into returning the full
# membership."
MEMBER_LIST_MAX_PAGE_SIZE=100

# ─── Identity codes (Stage 6) ─────────────────────────────────────────────────
# HMAC key for the v1.<memberRef>.<issuedAt>.<hmac> payload carried by the QR
# code. §7 calls for a key management service; this env var is the nearest
# equivalent available here, same compromise as PASSWORD_PEPPER.
IDENTITY_CODE_HMAC_SECRET=CHANGE_ME_32_BYTES_MINIMUM

# R9 — the rotation window is a tunable setting, not a constant. §7: "start
# around 24 hours, monitor verification failures at outlets, and adjust."
# Changing this must need no code change.
IDENTITY_CODE_WINDOW_HOURS=24

# ─── Verification (Stage 7) ───────────────────────────────────────────────────
# §5: "Rate limited hard: a handful of lookups per staff member per hour.
# Membership numbers are sequential and printed on cards, so an unlimited
# lookup endpoint is an enumeration tool."
RATE_LIMIT_VERIFY_WINDOW_SECONDS=3600
RATE_LIMIT_VERIFY_PER_STAFF_MAX=30

# §5: the resolve result is "bound to a short-lived verification session --
# staff can act on that member for a few minutes, then the context expires."
# Recording a redemption requires one, so staff cannot act on a member they
# never resolved.
VERIFICATION_SESSION_TTL_SECONDS=300

# ─── Development conveniences ─────────────────────────────────────────────────
# Prints one-time passcodes to the server console, so a member sign-in can be
# completed by hand when no SMS provider is configured (PROGRESS.md Q6).
#
# Honoured ONLY when NODE_ENV is also 'development', and only for the exact
# string "true" -- see apps/api/src/security/dev-otp.ts for why both gates
# exist. Leave this off. It puts a live credential in your logs.
DEV_OTP_ECHO=false

# Applied to a bare local number, so a member can type 55550003 rather than
# +97455550003. Normalisation runs everywhere a phone enters the system, so the
# same person cannot be stored under two different shapes.
DEFAULT_PHONE_COUNTRY_CODE=+974

# ─── Reporting (Stage 8) ──────────────────────────────────────────────────────
# R13 — the one threshold §6 states outright: "a minimum cohort size of 5 below
# which the endpoint returns 'insufficient data' rather than a number."
# The cohort is distinct members, not rows.
REPORT_MIN_COHORT_SIZE=5

# §6: exports are "administrator-only, rate-limited, individually audited, and
# alerted in real time." No rate is given; a handful a day suits an action that
# should never become routine.
RATE_LIMIT_EXPORT_PER_USER_MAX=5
RATE_LIMIT_EXPORT_WINDOW_SECONDS=86400

# ─── Clients (Stages 10–12) ───────────────────────────────────────────────────
CORS_ORIGIN_MEMBER=http://localhost:5173
CORS_ORIGIN_VERIFY=http://localhost:5174
CORS_ORIGIN_ADMIN=http://localhost:5175
