# Privilege Guest Program — environment variables
#
# Copy to .env and fill in. Never commit .env.
#
# Values marked TODO(spec) are named here because a later stage needs them, but
# their correct value comes from a reference document that is currently empty.
# See PROGRESS.md → "Open questions blocking work".

# ─── Runtime (Stage 0) ────────────────────────────────────────────────────────
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info

# ─── Database (Stages 0–1) ────────────────────────────────────────────────────
# Port 5433, not 5432: the compose stack publishes there so it does not collide
# with a PostgreSQL already installed on the host.
#
# The role the application connects as. The redemption_immutability migration
# revokes UPDATE/DELETE on "Redemption", "AuditLog" and "ConsentRecord" and
# DELETE on "Member" from this role (R7, R16), so it must NOT own the schema
# and must NOT be a superuser — an owner cannot be denied its own tables.
DATABASE_URL=postgresql://pgp_app:pgp_local_app@localhost:5433/pgp?schema=public

# The owning role, used for `prisma migrate` and for the seed. Separate from the
# application role so the revocation above is meaningful.
DATABASE_MIGRATION_URL=postgresql://pgp_owner:pgp_local_dev@localhost:5433/pgp?schema=public

# ─── Credentials (Stage 2) ────────────────────────────────────────────────────
# security-implementation.md §3: a pepper held in the key management service,
# not the database. No KMS exists in this build; this env var is the nearest
# equivalent available — see DECISIONS.md. Never reuse across environments.
PASSWORD_PEPPER=CHANGE_ME_32_BYTES_MINIMUM
OTP_CODE_HMAC_SECRET=CHANGE_ME_32_BYTES_MINIMUM
OTP_TTL_SECONDS=300                  # 5 minutes — security-implementation.md §3
OTP_MAX_ATTEMPTS=5                   # security-implementation.md §3

# ─── Tokens (Stage 2) ─────────────────────────────────────────────────────────
# The signing algorithm (HS256) is pinned in code and never read from a token
# header — see src/security/tokens.ts and DECISIONS.md for why HS256 rather
# than the EdDSA/RS256 §4 prefers.
JWT_ISSUER=privilege-guest-program
JWT_AUDIENCE_MEMBER=pgp-member
JWT_AUDIENCE_STAFF=pgp-staff
JWT_SIGNING_KEY=CHANGE_ME_32_BYTES_MINIMUM

# security-implementation.md §4 lifetimes, by surface:
#   access  — 10 min administrator panel,
#             30 min member app. Held in memory by the client.
#   refresh — 12h staff (sliding), 30 days member (sliding). Delivered as an
#             httpOnly, SameSite=Strict cookie scoped to /auth/refresh, so it
#             survives a page reload and no script can read it. See
#             apps/api/src/security/session-cookie.ts.
ACCESS_TOKEN_TTL_MEMBER_SECONDS=1800
ACCESS_TOKEN_TTL_STAFF_DASHBOARD_SECONDS=600
REFRESH_TOKEN_TTL_MEMBER_SECONDS=2592000
REFRESH_TOKEN_TTL_STAFF_SECONDS=43200

# ─── Rate limiting (Stage 2) ──────────────────────────────────────────────────
# security-implementation.md §3/§4/§8 require rate limiting "per IP and per
# identifier" but give no exact thresholds. These are a documented assumption
# (BUILD-PLAN §0 rule 4) — see DECISIONS.md and PROGRESS.md open questions.
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_PER_IP_MAX=20
RATE_LIMIT_LOGIN_PER_IDENTIFIER_MAX=5
RATE_LIMIT_OTP_WINDOW_SECONDS=900
RATE_LIMIT_OTP_REQUEST_PER_IP_MAX=10
RATE_LIMIT_OTP_REQUEST_PER_IDENTIFIER_MAX=3
RATE_LIMIT_OTP_VERIFY_PER_IP_MAX=20

# ─── Member lifecycle (Stage 4) ───────────────────────────────────────────────
# security-implementation.md §3 requires claim codes to expire "after a defined
# period" but does not define one, and product-definition.md §8 is silent.
# 720h = 30 days, assuming a posted invitation letter. A documented assumption —
# see PROGRESS.md.
CLAIM_CODE_TTL_HOURS=720

# §10: consent is stored with the wording version it was given against, so
# changing the wording later does not retroactively reinterpret past consent.
# Bump this whenever the consent wording shown to members changes.
CONSENT_WORDING_VERSION=v1-2026-07

# §3: "Strict rate limiting on the activation endpoint, since a guessable claim
# code grants a genuine membership."
RATE_LIMIT_CLAIM_WINDOW_SECONDS=900
RATE_LIMIT_CLAIM_PER_IP_MAX=10

# §8: "Pagination caps so no endpoint can be coerced into returning the full
# membership."
MEMBER_LIST_MAX_PAGE_SIZE=100

# Applied to a bare local number, so a member can type 55550003 rather than
# +97455550003. Normalisation runs everywhere a phone enters the system, so the
# same person cannot be stored under two different shapes.
DEFAULT_PHONE_COUNTRY_CODE=+974

# ─── Reporting (Stage 8) ──────────────────────────────────────────────────────
# R13 — the one threshold §6 states outright: "a minimum cohort size of 5 below
# which the endpoint returns 'insufficient data' rather than a number."
# The cohort is distinct members, not rows.
REPORT_MIN_COHORT_SIZE=5

# §6: exports are "administrator-only, rate-limited, individually audited, and
# alerted in real time." No rate is given; a handful a day suits an action that
# should never become routine.
RATE_LIMIT_EXPORT_PER_USER_MAX=5
RATE_LIMIT_EXPORT_WINDOW_SECONDS=86400

# --- Google Sheets mirror (optional) -----------------------------------------
# PostgreSQL remains authoritative. This writes five managed, read-only tabs
# (_Sync, Members, Benefits, Outlets, Redemptions) and leaves other tabs alone.
# Member names, contact details, request notes, credentials and security records
# are deliberately excluded. Keep disabled until the dedicated workbook is
# private, the service identity has Editor access, and data residency is agreed.
GOOGLE_SHEETS_SYNC_ENABLED=false
# The value between /spreadsheets/d/ and /edit in the workbook URL.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
# Base64 of the service-account JSON file's private_key value (not the whole
# JSON document). Base64 is only an encoding; store this as a production secret.
GOOGLE_SHEETS_PRIVATE_KEY_BASE64=
# Full reconciliation cadence. Minimum 60 seconds; five minutes is the default.
GOOGLE_SHEETS_SYNC_INTERVAL_SECONDS=300

# ─── Clients (Stages 10–12) ───────────────────────────────────────────────────
CORS_ORIGIN_MEMBER=http://localhost:5173
CORS_ORIGIN_ADMIN=http://localhost:5175

# ── Stage 18 — one-time passcode delivery (PROGRESS.md Q6) ──────────────────
# 'none' generates codes and delivers nothing (stages 0-17 behaviour, and the
# default so an upgrade never starts mailing members by surprise). 'smtp'
# delivers by email — see src/notifications/code-sender.ts for why email rather
# than SMS, and why that is interim. 'sms' delivers passcodes over a carrier
# and everything else over SMTP, so it needs the SMTP block below as well —
# see src/notifications/sms-sender.ts for why it is not all-or-nothing.
OTP_DELIVERY_CHANNEL=none

# Required together when OTP_DELIVERY_CHANNEL=smtp; startup fails if any is
# missing. For Gmail: SMTP_PASSWORD must be a Google **App Password**, not the
# account password, and the account needs 2-Step Verification enabled.
# Port 465 with SMTP_SECURE=true (implicit TLS), or 587 with false (STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Gmail rewrites From to the authenticated account unless this is a verified
# alias, so normally set it to the same value as SMTP_USER.
SMTP_FROM=

# ── SMS passcode delivery ───────────────────────────────────────────────────
# Only read when OTP_DELIVERY_CHANNEL=sms.
#
# Why SMS at all, when email costs nothing: a member's passcode is the whole of
# their authentication (security-implementation.md §3), so whoever controls the
# delivery channel controls the membership. It also lifts a real limit — while
# the channel is smtp, a member cannot be created without an email address.
#
# Why not everything by SMS: at a carrier's published rate SMS costs roughly
# 170× email, two thirds of this system's messages are not passcodes, and an
# outlet notice has no phone number to reach at all. Passcodes go to the
# carrier; the rest falls through to SMTP.
#
# 'http'  a form-encoded gateway — the shape Ooredoo's Aamali service and most
#         regional bulk providers expose. Confirm the exact field names against
#         the provider's API document; buildRequest() in sms-transport.ts is
#         the one place they live.
# 'log'   writes the body to the log instead of sending it, so the wiring can
#         be proved before a carrier account exists. Refused in production —
#         the body contains the passcode.
SMS_PROVIDER=http
SMS_API_URL=
SMS_API_USER=
SMS_API_PASSWORD=
# The brand name a member sees as the sender, max 11 characters. Carriers in
# the region require this registered in advance and reject unregistered values,
# so it has a lead time — start it early.
SMS_SENDER_ID=

# Pacing. A gateway throttles rather than queues, so the dispatcher shapes
# traffic to these instead of discovering the ceiling through rejections.
# Raise them only against the provider's documented limits.
SMS_MAX_CONCURRENT=4
SMS_MAX_PER_SECOND=10
# Total tries per message. Only transient failures (429, 5xx, timeouts) are
# retried — a rejected recipient is never sent twice, because every attempt is
# separately billed.
SMS_MAX_ATTEMPTS=3
SMS_TIMEOUT_MS=8000

# ── Stage 19 — staff MFA (PROGRESS.md Q5) ──────────────────────────────────
# Encrypts the TOTP secret before it reaches the database, so a stolen dump
# alone yields no working second factors. 32 bytes, hex-encoded (64 chars):
#   openssl rand -hex 32
# Stage 20 moves this to a secret manager, per SECURITY-REVIEW.md.
MFA_SECRET_ENCRYPTION_KEY=

# Shown as the issuer in the authenticator app.
MFA_ISSUER_LABEL=Privilege Guest
# How long the post-password challenge is valid. Long enough to open an
# authenticator app; short enough that one left on a counter screen expires.
MFA_CHALLENGE_TTL_SECONDS=300
RATE_LIMIT_MFA_VERIFY_PER_USER_MAX=5
RATE_LIMIT_MFA_VERIFY_WINDOW_SECONDS=300

# Whether a dashboard password must be followed by a six-digit code.
#
# Leave this at true. It exists for one reason: on a local machine without an
# authenticator app, the six-digit code has to come from `npm run mfa:code` in a
# second terminal, and it changes every thirty seconds — friction on every
# sign-in, protecting a database of fictional members on 127.0.0.1.
#
# Set it to false in your own .env if you want email + password only while
# developing. The API refuses to start if it is false while NODE_ENV=production,
# because §3 requires a second factor on every dashboard account without
# exception. Nothing is deleted when it is off — enrollment, verification and
# recovery codes all still work, so turning it back on needs no re-enrollment.
STAFF_MFA_REQUIRED=true

# ─── Outlet fulfilment — the guest announces, the outlet confirms ────────────
#
# A guest is entitled to every published benefit already, so a request is a
# notice, not a petition. It goes to one outlet, and that outlet confirms the
# visit or records that it never happened. Nobody approves anything.

# The anti-spam rule: a guest may announce themselves once a minute. Enforced by
# counting rows, not by the in-memory limiter — a restart must not hand somebody
# a fresh allowance.
REQUEST_THROTTLE_SECONDS=60
# A notice nobody confirms is closed as NOT_USED after this long, so an outlet
# screen shows tonight's guests rather than an accumulating list.
REQUEST_EXPIRY_HOURS=24
REQUEST_EXPIRY_SWEEP_INTERVAL_SECONDS=900

# Whether the guest's own free text travels in the outlet's email.
#
# **Leave this false unless the hotel has agreed otherwise, and record the
# agreement.** The standing export policy excludes request free text from
# anything that leaves the system, and a guest can type their own name into that
# box — so "we never send names" stops being true the moment this is on. The
# outlet always sees the note on its own screen either way.
OUTLET_NOTIFY_INCLUDE_NOTE=false

# ─── Outlet sign-in ──────────────────────────────────────────────────────────
#
# Outlet sign-in uses a separate high-entropy token for every physical counter
# device. An outlet's optional email address is only a destination for request
# notifications; it is never a login identifier and there is no Google or
# password sign-in option for the outlet screen.
# There is no token value to put in this file: an administrator issues it under
# Admin → Outlets, the API stores only its SHA-256 digest, and the plaintext is
# shown once. The device exchanges it for the ordinary short access token and
# rotating httpOnly refresh-cookie session. Rotate a token if it may have leaked;
# revoke the device if it is lost or retired. Both actions end existing sessions.

# ─── The card's scannable code ───────────────────────────────────────────────
#
# Keys the HMAC over the identity payload printed on the back of the physical
# card and shown in the app. The same value serves both, which is the point: a
# guest can present either.
#
# **Rotating this invalidates every printed card at once.** That is also the only
# recovery a printed credential has, so it is a deliberate trade rather than an
# oversight. §7 asks for a key management service; there is none in this build,
# so this is the same compromise already made for PASSWORD_PEPPER.
IDENTITY_CODE_HMAC_SECRET=

# Applies to the rotating `v1` payload only. The card's `v2` payload is static —
# ink cannot rotate — and is accepted regardless of age. The code identifies and
# grants nothing; see DECISIONS.md for why that is acceptable.
IDENTITY_CODE_WINDOW_HOURS=24

# §5: "a handful of lookups per staff member per hour". A membership number is
# sequential and printed on the card, so an unmetered lookup endpoint is an
# enumeration tool no matter who holds the credential.
RATE_LIMIT_RESOLVE_PER_ACCOUNT_MAX=60
RATE_LIMIT_RESOLVE_WINDOW_SECONDS=3600

# How long an outlet may act on a member it has just scanned. Long enough to key
# in a bill, short enough that a screen left on a counter goes cold.
VERIFICATION_SESSION_TTL_SECONDS=600

# ══════════════════════════════════════════════════════════════════════════
# Production only — consumed by docker-compose.prod.yml. See DEPLOYMENT.md.
# Every one of these has no default: a missing value stops the stack rather
# than starting it with something guessable.
# ══════════════════════════════════════════════════════════════════════════

# Apex domain. Four hostnames come off it: my, api, admin, outlet.
DOMAIN=
# Let's Encrypt expiry notices.
ACME_EMAIL=

# Space-separated CIDRs allowed to reach the administrator panel, the outlet
# screen, and both /admin/* and /outlet/* API routes. Use the staff/back-of-house
# VLAN plus your VPN range.
#   INTERNAL_CIDR=203.0.113.0/24 10.8.0.0/24
#
# Do not include guest Wi-Fi, even though it is physically inside the hotel. A
# counter tablet on cellular is refused by design; move it onto the staff network
# or VPN. This is defence in depth: administrators still require password + MFA,
# and an outlet still requires its own per-device token.
INTERNAL_CIDR=

# Database. Two roles: the API connects as pgp_app, which is denied UPDATE and
# DELETE on Redemption at the database level (R7). Migrations run as pgp_owner.
POSTGRES_PASSWORD=
PGP_APP_PASSWORD=

# Behind Caddy this must be true, or every per-IP rate limit shares one bucket
# and every audited address is the proxy's.
TRUST_PROXY=true
