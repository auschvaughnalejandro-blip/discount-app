# Privilege Guest Program — environment variables
#
# Copy to .env and fill in. Never commit .env.
#
# Values marked TODO(spec) are named here because a later stage needs them, but
# their correct value comes from a reference document that is currently empty.
# See PROGRESS.md → "Open questions blocking work".

# ─── Runtime (Stage 0) ────────────────────────────────────────────────────────
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info

# ─── Database (Stages 0–1) ────────────────────────────────────────────────────
# Port 5433, not 5432: the compose stack publishes there so it does not collide
# with a PostgreSQL already installed on the host.
#
# The role the application connects as. The redemption_immutability migration
# revokes UPDATE/DELETE on "Redemption", "AuditLog" and "ConsentRecord" and
# DELETE on "Member" from this role (R7, R16), so it must NOT own the schema
# and must NOT be a superuser — an owner cannot be denied its own tables.
DATABASE_URL=postgresql://pgp_app:pgp_local_app@localhost:5433/pgp?schema=public

# The owning role, used for `prisma migrate` and for the seed. Separate from the
# application role so the revocation above is meaningful.
DATABASE_MIGRATION_URL=postgresql://pgp_owner:pgp_local_dev@localhost:5433/pgp?schema=public

# ─── Tokens (Stage 2) ─────────────────────────────────────────────────────────
# The signing algorithm is pinned in code and never read from a token header.
JWT_ISSUER=privilege-guest-program
JWT_AUDIENCE_MEMBER=pgp-member
JWT_AUDIENCE_STAFF=pgp-staff
# Symmetric secret, or a path/JWKS reference if the spec calls for asymmetric keys.
JWT_SIGNING_KEY=CHANGE_ME
ACCESS_TOKEN_TTL_SECONDS=            # TODO(spec) security-implementation.md §4
REFRESH_TOKEN_TTL_SECONDS=           # TODO(spec) security-implementation.md §4

# ─── OTP (Stage 2) ────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300                  # 5 minutes — BUILD-PLAN Stage 2
OTP_MAX_ATTEMPTS=5                   # BUILD-PLAN Stage 2

# ─── Rate limiting (Stage 2) ──────────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_IP=             # TODO(spec) security-implementation.md §4
RATE_LIMIT_LOGIN_PER_IDENTIFIER=     # TODO(spec) security-implementation.md §4
RATE_LIMIT_OTP_PER_IP=               # TODO(spec) security-implementation.md §4
RATE_LIMIT_OTP_PER_IDENTIFIER=       # TODO(spec) security-implementation.md §4
RATE_LIMIT_EXPORT_PER_USER=          # TODO(spec) security-implementation.md §6

# ─── Claim codes (Stage 4) ────────────────────────────────────────────────────
CLAIM_CODE_TTL_HOURS=                # TODO(spec) product-definition.md §8
CONSENT_WORDING_VERSION=             # TODO(spec) product-definition.md §8 (R15)

# ─── Identity codes (Stage 6) ─────────────────────────────────────────────────
# HMAC key for the v1.<memberRef>.<issuedAt>.<hmac> payload. A key management
# service in production.
IDENTITY_CODE_HMAC_SECRET=CHANGE_ME
IDENTITY_CODE_WINDOW_HOURS=24        # R9 default; changing this must need no code change

# ─── Reporting (Stage 8) ──────────────────────────────────────────────────────
REPORT_MIN_COHORT_SIZE=5             # R13 — groups below this return "insufficient data"

# ─── Clients (Stages 10–12) ───────────────────────────────────────────────────
CORS_ORIGIN_MEMBER=http://localhost:5173
CORS_ORIGIN_VERIFY=http://localhost:5174
CORS_ORIGIN_ADMIN=http://localhost:5175
